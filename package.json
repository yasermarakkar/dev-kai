{
  "name": "devkai-readiness",
  "version": "0.1.1",
  "description": "Production-readiness checklists for your apps: scans code, dependencies and config for security, logging, monitoring, auditing, database, scalability, reliability, CI/CD, frontend/a11y and API design gaps — and tells you where and how to fix them.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasermarakkar/dev-kai.git"
  },
  "homepage": "https://github.com/yasermarakkar/dev-kai#readme",
  "bugs": {
    "url": "https://github.com/yasermarakkar/dev-kai/issues"
  },
  "type": "module",
  "bin": {
    "devkai": "bin/devkai.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=90 \"test/*.test.js\"",
    "lint": "eslint .",
    "scan:self": "node bin/devkai.js scan . --review --offline --format console,md,html --fail-on high",
    "prepublishOnly": "npm run lint && npm test",
    "preversion": "npm run lint && npm test",
    "release:patch": "npm version patch -m \"chore: release v%s\"",
    "release:minor": "npm version minor -m \"chore: release v%s\"",
    "release:major": "npm version major -m \"chore: release v%s\""
  },
  "engines": {
    "node": ">=21"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "production-readiness",
    "checklist",
    "audit",
    "security",
    "owasp",
    "logging",
    "monitoring",
    "observability",
    "database-indexing",
    "scalability",
    "reliability",
    "accessibility",
    "wcag",
    "api-design",
    "ci",
    "monorepo",
    "cli",
    "static-analysis"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
