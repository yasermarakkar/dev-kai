{
  "name": "devkai-readiness",
  "version": "0.1.0",
  "description": "Production-readiness auditor: scans your apps and generates checklists for security, logging, monitoring, auditing, database, scaling and more — showing what is missing and where to improve.",
  "type": "module",
  "bin": {
    "devkai": "bin/devkai.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=90 \"test/*.test.js\"",
    "lint": "eslint .",
    "scan:self": "node bin/devkai.js scan . --review --offline --format console,md,html --fail-on high"
  },
  "engines": {
    "node": ">=21"
  },
  "keywords": [
    "audit",
    "checklist",
    "production-readiness",
    "security",
    "logging",
    "monitoring",
    "devops",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  }
}
